# --- Server ---
# Copy to `server/.env`. Loaded automatically from this folder (see bootstrap-env.js).
# Optional: `server/.env.local` overrides these values (good for machine-specific secrets).
NODE_ENV=development
PORT=5000

# MongoDB (either name works)
MONGO_URI=mongodb://127.0.0.1:27017/getvia
# MONGODB_URI=mongodb://127.0.0.1:27017/getvia

# --- MongoDB Atlas (example; copy from Atlas → Connect → Drivers) ---
# Prefer mongodb+srv — it handles replica set host discovery and works better from home/office networks:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/getvia?retryWrites=true&w=majority&appName=Cluster0
# Atlas → Network Access: add your IP (or 0.0.0.0/0 for local dev only).
# If connection still times out, try: MONGO_SERVER_SELECTION_TIMEOUT_MS=45000

# JWT — set JWT_SECRET alone OR both access + refresh
JWT_SECRET=change-me-min-32-characters-long-secret!!
# JWT_ACCESS_SECRET=...
# JWT_REFRESH_SECRET=...
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Firebase login access token TTL (default 7d)
# FIREBASE_JWT_EXPIRES=7d

# CORS — all browser origins that call this API
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Firebase Admin (required for POST /api/auth/firebase-login) ---
# EASIEST: Firebase Console → Project settings → Service accounts → Generate new private key.
# Save the JSON as server/secrets/firebase-adminsdk.json then restart the API.
# Set this explicitly (path relative to server/) so credentials never depend on auto-detection alone:
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json

# Or inline (private key = one line, use \n for newlines):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_PRIVATE_KEY_FILE=./secrets/firebase-private-key.pem
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/serviceAccount.json

# Debug Firebase auth flow
# DEBUG_AUTH=1

# Razorpay (Live mode) — Dashboard → API Keys → Live mode → Generate Key.
# Use rzp_live_* Key ID + matching Secret together. Restart the API after changes.
# Mismatched, test, or revoked keys cause checkout 401 Unauthorized.
RAZORPAY_KEY_ID=rzp_live_
RAZORPAY_KEY_SECRET=

# --- OpenAI (AI content generation) ---
OPENAI_API_KEY=
# Optional: override model (defaults to gpt-4o-mini)
OPENAI_MODEL=

# --- Cloudinary (image upload / CDN) — required for POST /api/upload/image ---
# Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional override (default 2MB): UPLOAD_MAX_IMAGE_BYTES=2097152
